38975>>>    Procedure SetActionButtons
38978>>>        tWebNavigateData NavigateData
38978>>>        tWebNavigateData NavigateData
38978>>>        Boolean bHasRecord
38978>>>        Handle hoDD
38978>>>
38978>>>        Get Server to hoDD
38979>>>        Get GetNavigateData to NavigateData
38980>>>        Get HasRecord of hoDD to bHasRecord
38981>>>
38981>>>        // let's hide all buttons and then Show the ones we want
38981>>>        WebSet pbRender of oEditBtn to False
38982>>>        WebSet pbRender of oSaveBtn to False
38983>>>        WebSet pbRender of oCancelChangesBtn to False
38984>>>        WebSet pbRender of oDeleteBtn to False
38985>>>
38985>>>        If (NavigateData.bReadOnly) Begin
38987>>>            WebSet pbRender of oEditBtn to True
38988>>>        End
38988>>>>
38988>>>        Else Begin
38989>>>            WebSet pbRender of oSaveBtn to True
38990>>>            WebSet pbRender of oCancelChangesBtn to True
38991>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38992>>>        End
38992>>>>
38992>>>    End_Procedure
