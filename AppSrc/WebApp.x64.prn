37309>>>    Procedure DoLogin
37312>>>        String sLoginName sPassword sPrevStateHash
37312>>>        Boolean bResult
37312>>>        
37312>>>        WebGet psValue of oLoginName to sLoginName
37313>>>        WebGet psValue of oPassword to sPassword
37314>>>        
37314>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37315>>>        
37315>>>        If (bResult) Begin
37317>>>            Send Hide of oLogin
37318>>>            Send ShowHeader of ghoWebApp
37319>>>            WebSet psCSSClass of ghoWebApp to ""
37320>>>            
37320>>>            WebGet psPrevStateHash to sPrevStateHash
37321>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37322>>>            
37322>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37322>>>            WebSet psValue of oLoginName to ""
37323>>>            WebSet psValue of oPassword  to ""
37324>>>            WebSet pbVisible of oWarning to False
37325>>>        End
37325>>>>
37325>>>        Else Begin
37326>>>            WebSet pbVisible of oWarning to True
37327>>>        End
37327>>>>
37327>>>    End_Procedure
