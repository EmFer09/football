37969>>>                // If from parent, this is a constrained drill down
37969>>>                // If Row select does main-zoom we don't need this
37969>>>                WebSet pbRender of oDetailButton to False
37970>>>                Case Break
37971>>>
37971>>>            Case (NavigateData.eNavigateType = nfFromChild)
37974>>>                // If from child, this is a probably a parent lookup from a Zoom
37974>>>                Case Break
37975>>>
37975>>>            Case (NavigateData.eNavigateType = nfFromMain)
37978>>>                // If from main, this is a probably a main-file lookup from a Zoom
37978>>>                WebSet pbRender of oDetailButton to False
37979>>>                Case Break
37980>>>
37980>>>            Case Else // must be nfUndefined
37980>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37980>>>                // If Row select does main-zoom we don't need this
37980>>>                WebSet pbRender of oDetailButton to False
37981>>>
37981>>>        Case End
37981>>>
37981>>>    End_Procedure
