38826>>>        Boolean bHasRecord
38826>>>        Handle hoDD
38826>>>
38826>>>        Get Server to hoDD
38827>>>        Get GetNavigateData to NavigateData
38828>>>        Get HasRecord of hoDD to bHasRecord
38829>>>
38829>>>        // let's hide all buttons and then Show the ones we want
38829>>>        WebSet pbRender of oEditBtn to False
38830>>>        WebSet pbRender of oSaveBtn to False
38831>>>        WebSet pbRender of oCancelChangesBtn to False
38832>>>        WebSet pbRender of oDeleteBtn to False
38833>>>
38833>>>        If (NavigateData.bReadOnly) Begin
38835>>>            WebSet pbRender of oEditBtn to True
38836>>>        End
38836>>>>
38836>>>        Else Begin
38837>>>            WebSet pbRender of oSaveBtn to True
38838>>>            WebSet pbRender of oCancelChangesBtn to True
38839>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38840>>>        End
38840>>>>
38840>>>    End_Procedure
