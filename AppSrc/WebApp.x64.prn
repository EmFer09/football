37995>>>                // If from main, this is a probably a main-file lookup from a Zoom
37995>>>                WebSet pbRender of oDetailButton to False
37996>>>                Case Break
37997>>>
37997>>>            Case Else // must be nfUndefined
37997>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37997>>>                // If Row select does main-zoom we don't need this
37997>>>                WebSet pbRender of oDetailButton to False
37998>>>
37998>>>        Case End
