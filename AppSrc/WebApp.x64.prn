37333>>>    Procedure OnLoad
37336>>>        String sPrevStateHash sView
37336>>>        
37336>>>        Forward Send OnLoad
37338>>>        
37338>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37338>>>        Get StateHash of ghoWebApp to sPrevStateHash
37339>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37340>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37342>>>            WebSet psPrevStateHash to sPrevStateHash
37343>>>        End
37343>>>>
37343>>>        
37343>>>    End_Procedure
