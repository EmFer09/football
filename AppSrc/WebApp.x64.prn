36618>>>>>>>    //
36618>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36618>>>>>>>    //
36618>>>>>>>    //  Params:
36618>>>>>>>    //      dtTime  Time to convert
36618>>>>>>>    //  Returns:
36618>>>>>>>    //      String with "HH:MM:SS" format
36618>>>>>>>    //
36618>>>>>>>    Function TimeToString DateTime dtTime Returns String
36620>>>>>>>        String sHours sMinutes sSeconds
36620>>>>>>>        
36620>>>>>>>        //  Extract parts
36620>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36621>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36622>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36623>>>>>>>        
36623>>>>>>>        //  Fill out with 0
36623>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36626>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36629>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36632>>>>>>>        
36632>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36633>>>>>>>    End_Function
