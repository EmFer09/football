37355>>>        Get StateHash of ghoWebApp to sPrevStateHash
37356>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37357>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37359>>>            WebSet psPrevStateHash to sPrevStateHash
37360>>>        End
37360>>>>
37360>>>        
37360>>>    End_Procedure
