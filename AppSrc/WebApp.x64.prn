38298>>>                Case Break
38299>>>
38299>>>            Case (NavigateData.eNavigateType = nfFromParent)
38302>>>                // If from parent, this is a constrained drill down.
38302>>>                Case Break
38303>>>
38303>>>            Case (NavigateData.eNavigateType = nfFromChild)
38306>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38306>>>                Case Break
38307>>>
38307>>>            Case Else // must be nfUndefined
38307>>>
38307>>>        Case End
38307>>>
38307>>>        Send SetActionButtons
38308>>>
38308>>>
38308>>>    End_Procedure
