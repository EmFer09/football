38264>>>    Procedure SetActionButtons
38267>>>        tWebNavigateData NavigateData
38267>>>        tWebNavigateData NavigateData
38267>>>        Boolean bHasRecord
38267>>>        Handle hoDD
38267>>>
38267>>>        Get Server to hoDD
38268>>>        Get GetNavigateData to NavigateData
38269>>>        Get HasRecord of hoDD to bHasRecord
38270>>>
38270>>>        // let's hide all buttons and then Show the ones we want
38270>>>        WebSet pbRender of oEditBtn to False
38271>>>        WebSet pbRender of oSaveBtn to False
38272>>>        WebSet pbRender of oCancelChangesBtn to False
38273>>>        WebSet pbRender of oDeleteBtn to False
38274>>>        
38274>>>        WebSet pbVisible of oPosicionBoton to True
38275>>>
38275>>>        If (NavigateData.bReadOnly) Begin
38277>>>            WebSet pbRender of oEditBtn to True
38278>>>        End
38278>>>>
38278>>>        Else Begin
38279>>>            WebSet pbRender of oSaveBtn to True
38280>>>            WebSet pbRender of oCancelChangesBtn to True
38281>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38282>>>            
38282>>>            WebSet pbVisible of oPosicionesJugadorLista to True
38283>>>        End
38283>>>>
38283>>>    End_Procedure
