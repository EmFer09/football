37772>>>    Procedure SetActionButtons
37775>>>        tWebNavigateData NavigateData
37775>>>        tWebNavigateData NavigateData
37775>>>        Boolean bHasRecord
37775>>>        Handle hoDD
37775>>>
37775>>>        Get Server to hoDD
37776>>>        Get GetNavigateData to NavigateData
37777>>>        Get HasRecord of hoDD to bHasRecord
37778>>>
37778>>>        // let's hide all buttons and then Show the ones we want
37778>>>        WebSet pbRender of oEditBtn to False
37779>>>        WebSet pbRender of oSaveBtn to False
37780>>>        WebSet pbRender of oCancelChangesBtn to False
37781>>>        WebSet pbRender of oDeleteBtn to False
37782>>>
37782>>>        If (NavigateData.bReadOnly) Begin
37784>>>            WebSet pbRender of oEditBtn to True
37785>>>        End
37785>>>>
37785>>>        Else Begin
37786>>>            WebSet pbRender of oSaveBtn to True
37787>>>            WebSet pbRender of oCancelChangesBtn to True
37788>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37789>>>        End
37789>>>>
37789>>>    End_Procedure
37790>>>
37790>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37793>>>        // Close after save
37793>>>        Send NavigateClose Self
37794>>>    End_Procedure
37795>>>
37795>>>    // this will close the view after a delete
37795>>>    Procedure OnViewDeleted Handle hoDDO
37798>>>        Send NavigateClose Self
37799>>>    End_Procedure
37800>>>
37800>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37803>>>        Case Begin
37803>>>            Case (NavigateData.eNavigateType = nfFromMain)
37805>>>                // If from main, this is a propbably a main file Select to Zoom.
37805>>>                Case Break
37806>>>
37806>>>            Case (NavigateData.eNavigateType = nfFromParent)
37809>>>                // If from parent, this is a constrained drill down.
37809>>>                Case Break
37810>>>
37810>>>            Case (NavigateData.eNavigateType = nfFromChild)
37813>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37813>>>                Case Break
37814>>>
37814>>>            Case Else // must be nfUndefined
37814>>>
37814>>>        Case End
37814>>>
37814>>>        Send SetActionButtons
37815>>>
37815>>>    End_Procedure
37816>>>
37816>>>End_Object 
