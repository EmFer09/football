38856>>>                Case Break
38857>>>
38857>>>            Case (NavigateData.eNavigateType = nfFromParent)
38860>>>                // If from parent, this is a constrained drill down.
38860>>>                Case Break
38861>>>
38861>>>            Case (NavigateData.eNavigateType = nfFromChild)
38864>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38864>>>                Case Break
38865>>>
38865>>>            Case Else // must be nfUndefined
38865>>>
38865>>>        Case End
38865>>>
38865>>>        Send SetActionButtons
38866>>>
38866>>>    End_Procedure
38867>>>
38867>>>End_Object 
