37881>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37884>>>        WebSet pbRender of oNewButton to True
37885>>>        WebSet pbRender of oDetailButton to True
37886>>>
37886>>>        Case Begin
37886>>>            Case (NavigateData.eNavigateType = nfFromParent)
37888>>>                // If from parent, this is a constrained drill down
37888>>>                // If Row select does main-zoom we don't need this
37888>>>                WebSet pbRender of oDetailButton to False
37889>>>                Case Break
37890>>>
37890>>>            Case (NavigateData.eNavigateType = nfFromChild)
37893>>>                // If from child, this is a probably a parent lookup from a Zoom
37893>>>                Case Break
37894>>>
37894>>>            Case (NavigateData.eNavigateType = nfFromMain)
37897>>>                // If from main, this is a probably a main-file lookup from a Zoom
37897>>>                WebSet pbRender of oDetailButton to False
37898>>>                Case Break
37899>>>
37899>>>            Case Else // must be nfUndefined
37899>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37899>>>                // If Row select does main-zoom we don't need this
37899>>>                WebSet pbRender of oDetailButton to False
37900>>>
37900>>>        Case End
37900>>>
37900>>>    End_Procedure
37901>>>
37901>>>
37901>>>End_Object 
