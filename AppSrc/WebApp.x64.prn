36730>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36732>>>>>>>        Integer iLen
36732>>>>>>>        Pointer pBase64
36732>>>>>>>        UChar[] ucaBuffer
36733>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36734>>>>>>>        If (not(pBase64)) Begin
36736>>>>>>>            Function_Return ucaBuffer
36737>>>>>>>        End
36737>>>>>>>>
36737>>>>>>>        
36737>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36738>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36739>>>>>>>        Move (Free(pBase64)) to iLen
36740>>>>>>>        Function_Return ucaBuffer
36741>>>>>>>    End_Function
