38377>>>        WebSet pbRender of oEditBtn to False
38378>>>        WebSet pbRender of oSaveBtn to False
38379>>>        WebSet pbRender of oCancelChangesBtn to False
38380>>>        WebSet pbRender of oDeleteBtn to False
38381>>>
38381>>>        If (NavigateData.bReadOnly) Begin
38383>>>            WebSet pbRender of oEditBtn to True
38384>>>        End
