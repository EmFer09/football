36915>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36916>>>>>    
36916>>>>>    Procedure Construct_Object
36918>>>>>        Handle hoObj
36918>>>>>        
36918>>>>>        Forward Send Construct_Object
36920>>>>>        
36920>>>>>        Set pbSessionCookieHttpOnly to True
36921>>>>>        
36921>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36922>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36923>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36924>>>>>        
36924>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36925>>>>>        Set phoUserDD to hoObj
36926>>>>>        
36926>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36927>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36928>>>>>        Set phoSessionDD to hoObj
36929>>>>>        
36929>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36930>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36931>>>>>        Set phoCrypto to hoObj
36932>>>>>        
36932>>>>>        Property Boolean pbPasswordHashing True
36933>>>>>        
36933>>>>>        Property Boolean pbCreatingNewSession False
