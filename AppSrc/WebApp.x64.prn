37542>>>>>    // Cambiar a un entrenador de equipo, que el cambio también afecte los contadores de número de equipos en cada liga
37542>>>>>    Procedure Backout
37544>>>>>        Forward Send Backout
37546>>>>> 
37546>>>>>        Integer iEquipos // para guardar el número de equipos antes de hacer los cambios
37546>>>>>  
37546>>>>>        Move liga.Equipos to iEquipos // lee el número de equipos en ese momento (después de hacer el forward send)
37547>>>>>
37547>>>>>        If (iEquipos > 0) Begin
37549>>>>>            Decrement iEquipos
37550>>>>>            Move iEquipos to liga.Equipos // lee el nuevo valor con el valor restado del total
37551>>>>>        End
37551>>>>>>
37551>>>>>        Else Begin
37552>>>>>            Send UserError "No se puede quitar ningún equipo más" "ERROR" // para recoger el fallo en el caso de que iEquipos < 0
37553>>>>>        End    
37553>>>>>>
37553>>>>>    End_Procedure
37554>>>>>    
37554>>>>>    // después de restar el equipo a la liga original, hay que sumarlo al contador de la nueva liga, siempre que no se pase del límite de equipos por liga
37554>>>>>    Procedure Update
37556>>>>>        Forward Send Update
37558>>>>>       
37558>>>>>        Integer iEquipos
37558>>>>>        Integer iEquiposMax
37558>>>>>        
37558>>>>>        Move liga.Equipos to iEquipos
37559>>>>>        Move liga.EquiposMax to iEquiposMax
37560>>>>>        
37560>>>>>        If (iEquipos < iEquiposMax) Begin
37562>>>>>            Increment iEquipos
37563>>>>>            Move iEquipos to liga.Equipos
37564>>>>>        End
37564>>>>>>
37564>>>>>        Else Begin
37565>>>>>            Send UserError "Esa liga ha llegado al límite de equipos máximo, no admite más equipos" "ERROR"
37566>>>>>        End
37566>>>>>>
37566>>>>>        
37566>>>>>        
37566>>>>>    End_Procedure
37567>>>>>
37567>>>>>
37567>>>>>End_Class
