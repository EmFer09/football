36601>>>>>>>    //
36601>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36601>>>>>>>    //
36601>>>>>>>    //  Params:
36601>>>>>>>    //      dtTime  Time to convert
36601>>>>>>>    //  Returns:
36601>>>>>>>    //      String with "HH:MM:SS" format
36601>>>>>>>    //
36601>>>>>>>    Function TimeToString DateTime dtTime Returns String
36603>>>>>>>        String sHours sMinutes sSeconds
36603>>>>>>>        
36603>>>>>>>        //  Extract parts
36603>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36604>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36605>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36606>>>>>>>        
36606>>>>>>>        //  Fill out with 0
36606>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36609>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36612>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36615>>>>>>>        
36615>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36616>>>>>>>    End_Function
36617>>>>>>>    
36617>>>>>>>    //
36617>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36617>>>>>>>    //
36617>>>>>>>    //  Params:
36617>>>>>>>    //      dtTime  Datetime variable to add time to
36617>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36617>>>>>>>    //  Returns:
36617>>>>>>>    //      dtDateTime with the loaded time
36617>>>>>>>    //
36617>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36619>>>>>>>        String sHours sMinutes sSeconds
36619>>>>>>>        
36619>>>>>>>        //  Extract parts
36619>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36620>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36621>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36622>>>>>>>        
36622>>>>>>>        //  Set to DateTime
36622>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36623>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36624>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36625>>>>>>>        
36625>>>>>>>        Function_Return dtTime
36626>>>>>>>    End_Function
