37326>>>    Procedure DoLogin
37329>>>        String sLoginName sPassword sPrevStateHash
37329>>>        Boolean bResult
37329>>>        
37329>>>        WebGet psValue of oLoginName to sLoginName
37330>>>        WebGet psValue of oPassword to sPassword
37331>>>        
37331>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37332>>>        
37332>>>        If (bResult) Begin
37334>>>            Send Hide of oLogin
37335>>>            Send ShowHeader of ghoWebApp
37336>>>            WebSet psCSSClass of ghoWebApp to ""
37337>>>            
37337>>>            WebGet psPrevStateHash to sPrevStateHash
37338>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37339>>>            
37339>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37339>>>            WebSet psValue of oLoginName to ""
37340>>>            WebSet psValue of oPassword  to ""
37341>>>            WebSet pbVisible of oWarning to False
37342>>>        End
37342>>>>
37342>>>        Else Begin
37343>>>            WebSet pbVisible of oWarning to True
37344>>>        End
37344>>>>
37344>>>    End_Procedure
