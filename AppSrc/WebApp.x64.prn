38997>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39000>>>        WebSet pbRender of oNewButton to True
39001>>>        WebSet pbRender of oDetailButton to True
39002>>>
39002>>>        Case Begin
39002>>>            Case (NavigateData.eNavigateType = nfFromParent)
39004>>>                // If from parent, this is a constrained drill down
39004>>>                // If Row select does main-zoom we don't need this
39004>>>                WebSet pbRender of oDetailButton to False
39005>>>                Case Break
39006>>>
39006>>>            Case (NavigateData.eNavigateType = nfFromChild)
39009>>>                // If from child, this is a probably a parent lookup from a Zoom
39009>>>                Case Break
39010>>>
39010>>>            Case (NavigateData.eNavigateType = nfFromMain)
39013>>>                // If from main, this is a probably a main-file lookup from a Zoom
39013>>>                WebSet pbRender of oDetailButton to False
39014>>>                Case Break
39015>>>
39015>>>            Case Else // must be nfUndefined
39015>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39015>>>                // If Row select does main-zoom we don't need this
39015>>>                WebSet pbRender of oDetailButton to False
39016>>>
39016>>>        Case End
39016>>>
39016>>>    End_Procedure
39017>>>
39017>>>
39017>>>End_Object 
