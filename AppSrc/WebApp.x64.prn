36634>>>>>>>    //
36634>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36636>>>>>>>        String sHours sMinutes sSeconds
36636>>>>>>>        
36636>>>>>>>        //  Extract parts
36636>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36637>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36638>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36639>>>>>>>        
36639>>>>>>>        //  Set to DateTime
36639>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36640>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36641>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36642>>>>>>>        
36642>>>>>>>        Function_Return dtTime
36643>>>>>>>    End_Function
