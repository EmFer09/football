36938>>>>>    Procedure End_Construct_Object
36940>>>>>        Forward Send End_Construct_Object
36942>>>>>        
36942>>>>>        Handle hoCrypto
36942>>>>>        Integer iFieldLen
36942>>>>>        If (pbPasswordHashing(Self)) Begin
36944>>>>>            Get phoCrypto to hoCrypto
36945>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36948>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36950>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36951>>>>>>
36951>>>>>            End
36951>>>>>>
36951>>>>>        End
36951>>>>>>
36951>>>>>    End_Procedure
36952>>>>>    
36952>>>>>    Function CreateSession String sRemoteAddress Returns String
36954>>>>>        String sSessionKey
36954>>>>>        Integer iErr
36954>>>>>        Boolean bLogWebSession
36954>>>>>        Handle hoSessionDD       
36954>>>>>        Get phoSessionDD to hoSessionDD
36955>>>>>        
36955>>>>>        //  Get session key
36955>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36957>>>>>        
36957>>>>>        Get pbLogWebSession to bLogWebSession
36958>>>>>        If not bLogWebSession Begin
36960>>>>>            Function_Return sSessionKey        
36961>>>>>        End
36961>>>>>>
36961>>>>>
36961>>>>>        //  Store session
36961>>>>>        Send Clear of hoSessionDD
36962>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36963>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36964>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36965>>>>>        Get Request_Validate of hoSessionDD to iErr
36966>>>>>        If (iErr) Begin
36968>>>>>            // this should not happen. If it does its a programming error
36968>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36969>>>>>>
36969>>>>>            Function_Return ""
36970>>>>>        End
36970>>>>>>
36970>>>>>        Send Request_Save of hoSessionDD
36971>>>>>        If (Err) Begin
36973>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36973>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36974>>>>>>
36974>>>>>            Function_Return ""
36975>>>>>        End
36975>>>>>>
36975>>>>>       
36975>>>>>        Function_Return sSessionKey        
36976>>>>>    End_Function
36977>>>>>    
36977>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36979>>>>>        DateTime dtLastAccess dtCurrent
36979>>>>>        TimeSpan tsDiff
36979>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36979>>>>>        Boolean bResult bCreatingNewSession
36979>>>>>        Boolean bLogWebSession bLoadWebApp
36979>>>>>        Integer eLoginMode
36979>>>>>        String sTime
36979>>>>>        Handle hoSessionDD hoUserDD       
36979>>>>>        
36979>>>>>        Move False to bLoadWebApp
36980>>>>>        If (num_arguments >= 2) Begin
36982>>>>>            Move bOptLoadWebApp to bLoadWebApp
36983>>>>>        End
36983>>>>>>
36983>>>>>        
36983>>>>>        Get phoSessionDD to hoSessionDD
36984>>>>>        Get phoUserDD to hoUserDD
36985>>>>>        
36985>>>>>        Get pbLogWebSession to bLogWebSession
36986>>>>>        Get peLoginMode to eLoginMode
36987>>>>>        
36987>>>>>        // for this object, you can only disable logging if login completely is disabled
36987>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36989>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36990>>>>>>
36990>>>>>            Function_Return False
36991>>>>>        End
36991>>>>>>
36991>>>>>
36991>>>>>        //  Clear session properties
36991>>>>>        Set psSessionKey to ""
36992>>>>>        Send UpdateSessionProperties True
36993>>>>>        
36993>>>>>        If not bLogWebSession Begin
36995>>>>>            Forward Get ValidateSession sSessionKey to bResult
36997>>>>>            Function_Return bResult
36998>>>>>        End        
36998>>>>>>
36998>>>>>        
36998>>>>>        Move False to bResult
36999>>>>>        Get piSessionTimeout to iSessionTimeout 
37000>>>>>        
37000>>>>>        //  Check if session exists
37000>>>>>        Send Clear of hoSessionDD
37001>>>>>        Move sSessionKey to WebAppSession.SessionKey
37002>>>>>        Send Find of hoSessionDD EQ Index.1
37003>>>>>            
37003>>>>>        If (Found) Begin
37005>>>>>            //  Calculate timespan between now and last access time
37005>>>>>            Move (CurrentDateTime()) to dtCurrent
37006>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37007>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37008>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37009>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37010>>>>>            
37010>>>>>            //  Check if session didn't time out
37010>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37012>>>>>                Forward Get ValidateSession sSessionKey to bResult
37014>>>>>                   
37014>>>>>                If (bResult) Begin
37016>>>>>                    //  Update session record
37016>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37017>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37018>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37019>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37020>>>>>                    Get Request_Validate of hoSessionDD to iErr
37021>>>>>                    If (iErr) Begin
37023>>>>>                        // this should not happen. If it does its a programming error
37023>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37024>>>>>>
37024>>>>>                        Function_Return False
37025>>>>>                    End
37025>>>>>>
37025>>>>>                    Send Request_Save of hoSessionDD
37026>>>>>                    
37026>>>>>                    //  Update user properties
37026>>>>>                    Send UpdateSessionProperties False
37027>>>>>                End
37027>>>>>>
37027>>>>>            End
37027>>>>>>
37027>>>>>            Else Begin
37028>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37028>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37029>>>>>                
37029>>>>>                If (not(bCreatingNewSession)) Begin
37031>>>>>                    If (not(bLoadWebApp)) Begin
37033>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37034>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37035>>>>>>
37035>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37036>>>>>                    End
37036>>>>>>
37036>>>>>                    Else Begin
37037>>>>>                        Set pbCreatingNewSession to True                    
37038>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37039>>>>>                        Set pbCreatingNewSession to False                        
37040>>>>>                    End
37040>>>>>>
37040>>>>>                End
37040>>>>>>
37040>>>>>            End
37040>>>>>>
37040>>>>>        End
37040>>>>>>
37040>>>>>        Else Begin
37041>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37042>>>>>>
37042>>>>>        End
37042>>>>>>
37042>>>>>        
37042>>>>>        Function_Return bResult
37043>>>>>    End_Function
37044>>>>>    
37044>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37046>>>>>        If (not(pbPasswordHashing(Self))) Begin
37048>>>>>            Move sPassword to sHash
37049>>>>>            Function_Return True
37050>>>>>        End
37050>>>>>>
37050>>>>>        
37050>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37052>>>>>            Function_Return False
37053>>>>>        End
37053>>>>>>
37053>>>>>        Move ("V1$" + sHash) to sHash
37054>>>>>        Function_Return True
37055>>>>>    End_Function
37056>>>>>    
37056>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37058>>>>>        If (not(pbPasswordHashing(Self))) Begin
37060>>>>>            Move False to bShouldUpgrade
37061>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37062>>>>>        End
37062>>>>>>
37062>>>>>        
37062>>>>>        String sVersion
37062>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37063>>>>>        If (sVersion = "V1$") Begin
37065>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37068>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37069>>>>>        End
37069>>>>>>
37069>>>>>        Else Begin
37070>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37073>>>>>            Function_Return False
37074>>>>>        End
37074>>>>>>
37074>>>>>    End_Function
37075>>>>>    
37075>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37077>>>>>        Handle hoUserDD
37077>>>>>        Integer iErr
37077>>>>>        Get phoUserDD to hoUserDD
37078>>>>>        
37078>>>>>        //  Find the user
37078>>>>>        Send Clear of hoUserDD
37079>>>>>        Move sLoginName to WebAppUser.LoginName
37080>>>>>        Send Find of hoUserDD EQ Index.1
37081>>>>>        If (Found) Begin
37083>>>>>            Send Clear of hoUserDD
37084>>>>>            Function_Return False
37085>>>>>        End
37085>>>>>>
37085>>>>>        
37085>>>>>        Send Clear of hoUserDD
37086>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37087>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37088>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37090>>>>>            Send Clear of hoUserDD
37091>>>>>            Function_Return False
37092>>>>>        End
37092>>>>>>
37092>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37093>>>>>        Get Request_Validate of hoUserDD to iErr
37094>>>>>        If (iErr) Begin
37096>>>>>            Send Clear of hoUserDD
37097>>>>>            Function_Return False
37098>>>>>        End
37098>>>>>>
37098>>>>>        
37098>>>>>        Send Request_Save of hoUserDD
37099>>>>>        Function_Return (not(Err))
37100>>>>>    End_Function
37101>>>>>    
37101>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37103>>>>>        String sSessionKey sUserPassword
37103>>>>>        Handle hoSessionDD hoUserDD
37103>>>>>        Boolean bMatch bUpgrade
37103>>>>>        
37103>>>>>        Get phoSessionDD to hoSessionDD
37104>>>>>        Get phoUserDD to hoUserDD
37105>>>>>        Integer iErr eLoginMode
37105>>>>>        
37105>>>>>        // Refind session record
37105>>>>>        Get psSessionKey to sSessionKey
37106>>>>>        Send Clear of hoSessionDD
37107>>>>>        Move sSessionKey to WebAppSession.SessionKey
37108>>>>>        Send Find of hoSessionDD EQ Index.1
37109>>>>>        
37109>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37111>>>>>            Get peLoginMode to eLoginMode
37112>>>>>            
37112>>>>>            //  Find the user
37112>>>>>            Move sLoginName to WebAppUser.LoginName
37113>>>>>            Send Find of hoUserDD EQ Index.1
37114>>>>>            
37114>>>>>            // Check username and password
37114>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37116>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37117>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37118>>>>>                
37118>>>>>                If (bMatch) Begin
37120>>>>>                    // Store the login
37120>>>>>                    If (bUpgrade) Begin
37122>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37123>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37126>>>>>                    End
37126>>>>>>
37126>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37127>>>>>                    Get Request_Validate of hoSessionDD to iErr
37128>>>>>                    If (iErr) Begin
37130>>>>>                        // this should not happen. If it does its a programming error
37130>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37131>>>>>>
37131>>>>>                        Function_Return False
37132>>>>>                    End
37132>>>>>>
37132>>>>>                    
37132>>>>>                    Send Request_Save of hoSessionDD
37133>>>>>                    
37133>>>>>                    // Update session properties
37133>>>>>                    Send UpdateSessionProperties False
37134>>>>>                    Send NotifyChangeRights
37135>>>>>                    Function_Return True
37136>>>>>                End
37136>>>>>>
37136>>>>>                Else Begin
37137>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37137>>>>>                    Send Clear of hoUserDD
37138>>>>>                End
37138>>>>>>
37138>>>>>            End
37138>>>>>>
37138>>>>>            Else Begin
37139>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37139>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37140>>>>>            End
37140>>>>>>
37140>>>>>        End
37140>>>>>>
37140>>>>>        Else Begin
