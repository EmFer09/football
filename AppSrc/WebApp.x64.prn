38974>>>    Procedure SetActionButtons
38977>>>        tWebNavigateData NavigateData
38977>>>        tWebNavigateData NavigateData
38977>>>        Boolean bHasRecord
38977>>>        Handle hoDD
38977>>>
38977>>>        Get Server to hoDD
38978>>>        Get GetNavigateData to NavigateData
38979>>>        Get HasRecord of hoDD to bHasRecord
38980>>>
38980>>>        // let's hide all buttons and then Show the ones we want
38980>>>        WebSet pbRender of oEditBtn to False
38981>>>        WebSet pbRender of oSaveBtn to False
38982>>>        WebSet pbRender of oCancelChangesBtn to False
38983>>>        WebSet pbRender of oDeleteBtn to False
38984>>>
38984>>>        If (NavigateData.bReadOnly) Begin
38986>>>            WebSet pbRender of oEditBtn to True
38987>>>        End
38987>>>>
38987>>>        Else Begin
38988>>>            WebSet pbRender of oSaveBtn to True
38989>>>            WebSet pbRender of oCancelChangesBtn to True
38990>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38991>>>        End
38991>>>>
38991>>>    End_Procedure
