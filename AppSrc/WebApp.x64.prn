37884>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37887>>>        WebSet pbRender of oNewButton to True
37888>>>        WebSet pbRender of oDetailButton to True
37889>>>
37889>>>        Case Begin
37889>>>            Case (NavigateData.eNavigateType = nfFromParent)
37891>>>                // If from parent, this is a constrained drill down
37891>>>                // If Row select does main-zoom we don't need this
37891>>>                WebSet pbRender of oDetailButton to False
37892>>>                Case Break
37893>>>
37893>>>            Case (NavigateData.eNavigateType = nfFromChild)
37896>>>                // If from child, this is a probably a parent lookup from a Zoom
37896>>>                Case Break
37897>>>
37897>>>            Case (NavigateData.eNavigateType = nfFromMain)
37900>>>                // If from main, this is a probably a main-file lookup from a Zoom
37900>>>                WebSet pbRender of oDetailButton to False
37901>>>                Case Break
37902>>>
37902>>>            Case Else // must be nfUndefined
37902>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37902>>>                // If Row select does main-zoom we don't need this
37902>>>                WebSet pbRender of oDetailButton to False
37903>>>
37903>>>        Case End
37903>>>
37903>>>    End_Procedure
