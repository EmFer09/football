36742>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36744>>>>>>>        Boolean bOk bRequireTimeCost
36744>>>>>>>        UChar[] ucaHash
36745>>>>>>>        
36745>>>>>>>        Case Begin
36745>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36747>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36748>>>>>>>                If (not(bOk)) Function_Return False
36751>>>>>>>                
36751>>>>>>>                Move True to bRequireTimeCost
36752>>>>>>>                Case Break
36753>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36756>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36757>>>>>>>                If (not(bOk)) Function_Return False
36760>>>>>>>                
36760>>>>>>>                Move True to bRequireTimeCost
36761>>>>>>>                Case Break
36762>>>>>>>            Case Else
36762>>>>>>>                Error 8710 "Invalid algorithm selected."
36763>>>>>>>>
36763>>>>>>>                Function_Return False
36764>>>>>>>        Case End
36764>>>>>>>        
36764>>>>>>>        String sSalt
36764>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36765>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36768>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36769>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36772>>>>>>>        
36772>>>>>>>        If (bRequireTimeCost) Begin
36774>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36775>>>>>>>        End
36775>>>>>>>>
36775>>>>>>>        Else Begin
36776>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36777>>>>>>>        End
36777>>>>>>>>
36777>>>>>>>        
36777>>>>>>>        Function_Return bOk
36778>>>>>>>    End_Function
36779>>>>>>>    
36779>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36781>>>>>>>        UChar[] ucaSalt
36782>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36783>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36786>>>>>>>        
36786>>>>>>>        If (num_arguments > 4) Begin
36788>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36789>>>>>>>        End
36789>>>>>>>>
36789>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36790>>>>>>>    End_Function
36791>>>>>>>    
36791>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36793>>>>>>>        Boolean bRequiresTimeCost
36793>>>>>>>        UInteger uiAlgo uiTimeCost
36793>>>>>>>        Integer iBegin iEnd
36793>>>>>>>        String sSalt
36793>>>>>>>        
36793>>>>>>>        Move 1 to iBegin
36794>>>>>>>        
36794>>>>>>>        // Parse Algo
36794>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36795>>>>>>>        If (not(iEnd)) Function_Return False
36798>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36799>>>>>>>        
36799>>>>>>>        // Parse Salt
36799>>>>>>>        Move (iEnd + 1) to iBegin
36800>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36801>>>>>>>        If (not(iEnd)) Function_Return False
36804>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36805>>>>>>>        
36805>>>>>>>        Case Begin
36805>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36807>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36810>>>>>>>                Move True to bRequiresTimeCost
36811>>>>>>>                Case Break
36812>>>>>>>            Case Else
36812>>>>>>>                Error 8710 "Invalid algorithm selected."
36813>>>>>>>>
36813>>>>>>>                Function_Return False
36814>>>>>>>        Case End
36814>>>>>>>        
36814>>>>>>>        // Parse optional timecost
36814>>>>>>>        If (bRequiresTimeCost) Begin
36816>>>>>>>            Move (iEnd + 1) to iBegin
36817>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36818>>>>>>>            If (not(iEnd)) Function_Return False
36821>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36822>>>>>>>        End
36822>>>>>>>>
36822>>>>>>>        
36822>>>>>>>        // Parse rest hash
36822>>>>>>>        Move (iEnd + 1) to iBegin
36823>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36824>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36827>>>>>>>        
36827>>>>>>>        // Base64Decode
36827>>>>>>>        UChar[] ucaSalt
36828>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36829>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36832>>>>>>>        
36832>>>>>>>        // Create new hash
36832>>>>>>>        String sNewHash
36832>>>>>>>        If (bRequiresTimeCost) Begin
36834>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36836>>>>>>>                Function_Return False 
36837>>>>>>>            End
36837>>>>>>>>
36837>>>>>>>        End
36837>>>>>>>>
36837>>>>>>>        Else Begin
36838>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36840>>>>>>>                Function_Return False 
36841>>>>>>>            End
36841>>>>>>>>
36841>>>>>>>        End
36841>>>>>>>>
36841>>>>>>>        Function_Return (sNewHash = sHash)
36842>>>>>>>    End_Function
36843>>>>>>>    
36843>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36845>>>>>>>        Boolean bRequireTimeCost
36845>>>>>>>        UBigInt ullSize
36845>>>>>>>        UChar[] ucaSalt
36846>>>>>>>        String sSalt
36846>>>>>>>        
36846>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36847>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36848>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36851>>>>>>>        
36851>>>>>>>        Case Begin
36851>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36853>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36854>>>>>>>                Move True to bRequireTimeCost
36855>>>>>>>                Case Break
36856>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36859>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36860>>>>>>>                Move True to bRequireTimeCost
36861>>>>>>>                Case Break
36862>>>>>>>            Case Else
36862>>>>>>>                Error 8710 "Invalid algorithm selected."
36863>>>>>>>>
36863>>>>>>>                Function_Return 0
36864>>>>>>>        Case End
36864>>>>>>>        
36864>>>>>>>        // calculate base64 in a non-floating-manner
36864>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36865>>>>>>>        
36865>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36866>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36867>>>>>>>        If (bRequireTimeCost) Begin
36869>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36870>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36871>>>>>>>        End
36871>>>>>>>>
36871>>>>>>>        Else Begin
36872>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36873>>>>>>>        End
36873>>>>>>>>
36873>>>>>>>        
36873>>>>>>>        Function_Return ullSize
36874>>>>>>>    End_Function
36875>>>>>>>End_Class
36876>>>>>>>
36876>>>>>>>Class cPasswordHasher is a cObject
36877>>>>>>>    
36877>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36878>>>>>>>    
36878>>>>>>>    Procedure Construct_Object
36880>>>>>>>        Forward Send Construct_Object
36882>>>>>>>        
36882>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36883>>>>>>>        Property UInteger   puiSaltSize         16
36884>>>>>>>        
36884>>>>>>>        Property UInteger   puiOptTimeCost      420000
36885>>>>>>>    End_Procedure
36886>>>>>>>    
36886>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36888>>>>>>>        Boolean bOk
36888>>>>>>>        UInteger uiAlgo
36888>>>>>>>        Get peAlgorithm to uiAlgo
36889>>>>>>>        
36889>>>>>>>        Case Begin
36889>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36891>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36894>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36895>>>>>>>                Case Break
36896>>>>>>>            Case Else
36896>>>>>>>                Error 8710 "Invalid algorithm selected."
36897>>>>>>>>
36897>>>>>>>                Function_Return False
36898>>>>>>>        Case End
36898>>>>>>>        
36898>>>>>>>        Function_Return bOk
36899>>>>>>>    End_Function
36900>>>>>>>    
36900>>>>>>>    Function RequiredBufferSize Returns UBigInt
36902>>>>>>>        UBigInt ullSize
36902>>>>>>>        UInteger uiAlgo
36902>>>>>>>        Get peAlgorithm to uiAlgo
36903>>>>>>>        
36903>>>>>>>        Case Begin
36903>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36905>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36908>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36909>>>>>>>                Case Break
36910>>>>>>>            Case Else
36910>>>>>>>                Error 8710 "Invalid algorithm selected."
36911>>>>>>>>
36911>>>>>>>                Function_Return 0
36912>>>>>>>        Case End
36912>>>>>>>        
36912>>>>>>>        Function_Return ullSize
36913>>>>>>>    End_Function
36914>>>>>>>
36914>>>>>>>End_Class
