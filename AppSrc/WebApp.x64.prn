36739>>>>>>>        Move (Base64Encode(AddressOf(ucaBuffer), SizeOfArray(ucaBuffer))) to pBase64
36740>>>>>>>        If (not(pBase64)) Begin
36742>>>>>>>            Function_Return sBase64
36743>>>>>>>        End
36743>>>>>>>>
36743>>>>>>>        Move (PointerToString(pBase64)) to sBase64
36744>>>>>>>        Move (Free(pBase64)) to iErr
36745>>>>>>>        Function_Return sBase64
36746>>>>>>>    End_Function
36747>>>>>>>    
36747>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36749>>>>>>>        Integer iLen
36749>>>>>>>        Pointer pBase64
36749>>>>>>>        UChar[] ucaBuffer
36750>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36751>>>>>>>        If (not(pBase64)) Begin
36753>>>>>>>            Function_Return ucaBuffer
36754>>>>>>>        End
36754>>>>>>>>
36754>>>>>>>        
36754>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36755>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36756>>>>>>>        Move (Free(pBase64)) to iLen
36757>>>>>>>        Function_Return ucaBuffer
36758>>>>>>>    End_Function
36759>>>>>>>    
36759>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36761>>>>>>>        Boolean bOk bRequireTimeCost
36761>>>>>>>        UChar[] ucaHash
36762>>>>>>>        
36762>>>>>>>        Case Begin
36762>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36764>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36765>>>>>>>                If (not(bOk)) Function_Return False
36768>>>>>>>                
36768>>>>>>>                Move True to bRequireTimeCost
36769>>>>>>>                Case Break
36770>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36773>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36774>>>>>>>                If (not(bOk)) Function_Return False
36777>>>>>>>                
36777>>>>>>>                Move True to bRequireTimeCost
36778>>>>>>>                Case Break
36779>>>>>>>            Case Else
36779>>>>>>>                Error 8710 "Invalid algorithm selected."
36780>>>>>>>>
36780>>>>>>>                Function_Return False
36781>>>>>>>        Case End
36781>>>>>>>        
36781>>>>>>>        String sSalt
36781>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36782>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36785>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36786>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36789>>>>>>>        
36789>>>>>>>        If (bRequireTimeCost) Begin
36791>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36792>>>>>>>        End
36792>>>>>>>>
36792>>>>>>>        Else Begin
36793>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36794>>>>>>>        End
36794>>>>>>>>
36794>>>>>>>        
36794>>>>>>>        Function_Return bOk
36795>>>>>>>    End_Function
36796>>>>>>>    
36796>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36798>>>>>>>        UChar[] ucaSalt
36799>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36800>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36803>>>>>>>        
36803>>>>>>>        If (num_arguments > 4) Begin
36805>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36806>>>>>>>        End
36806>>>>>>>>
36806>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36807>>>>>>>    End_Function
36808>>>>>>>    
36808>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36810>>>>>>>        Boolean bRequiresTimeCost
36810>>>>>>>        UInteger uiAlgo uiTimeCost
36810>>>>>>>        Integer iBegin iEnd
36810>>>>>>>        String sSalt
36810>>>>>>>        
36810>>>>>>>        Move 1 to iBegin
36811>>>>>>>        
36811>>>>>>>        // Parse Algo
36811>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36812>>>>>>>        If (not(iEnd)) Function_Return False
36815>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36816>>>>>>>        
36816>>>>>>>        // Parse Salt
36816>>>>>>>        Move (iEnd + 1) to iBegin
36817>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36818>>>>>>>        If (not(iEnd)) Function_Return False
36821>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36822>>>>>>>        
36822>>>>>>>        Case Begin
36822>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36824>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36827>>>>>>>                Move True to bRequiresTimeCost
36828>>>>>>>                Case Break
36829>>>>>>>            Case Else
36829>>>>>>>                Error 8710 "Invalid algorithm selected."
36830>>>>>>>>
36830>>>>>>>                Function_Return False
36831>>>>>>>        Case End
36831>>>>>>>        
36831>>>>>>>        // Parse optional timecost
36831>>>>>>>        If (bRequiresTimeCost) Begin
36833>>>>>>>            Move (iEnd + 1) to iBegin
36834>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36835>>>>>>>            If (not(iEnd)) Function_Return False
36838>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36839>>>>>>>        End
36839>>>>>>>>
36839>>>>>>>        
36839>>>>>>>        // Parse rest hash
36839>>>>>>>        Move (iEnd + 1) to iBegin
36840>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36841>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36844>>>>>>>        
36844>>>>>>>        // Base64Decode
36844>>>>>>>        UChar[] ucaSalt
36845>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36846>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36849>>>>>>>        
36849>>>>>>>        // Create new hash
36849>>>>>>>        String sNewHash
36849>>>>>>>        If (bRequiresTimeCost) Begin
36851>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36853>>>>>>>                Function_Return False 
36854>>>>>>>            End
36854>>>>>>>>
36854>>>>>>>        End
36854>>>>>>>>
36854>>>>>>>        Else Begin
36855>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36857>>>>>>>                Function_Return False 
36858>>>>>>>            End
36858>>>>>>>>
36858>>>>>>>        End
36858>>>>>>>>
36858>>>>>>>        Function_Return (sNewHash = sHash)
36859>>>>>>>    End_Function
36860>>>>>>>    
36860>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36862>>>>>>>        Boolean bRequireTimeCost
36862>>>>>>>        UBigInt ullSize
36862>>>>>>>        UChar[] ucaSalt
36863>>>>>>>        String sSalt
36863>>>>>>>        
36863>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36864>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36865>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36868>>>>>>>        
36868>>>>>>>        Case Begin
36868>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36870>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36871>>>>>>>                Move True to bRequireTimeCost
36872>>>>>>>                Case Break
36873>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36876>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36877>>>>>>>                Move True to bRequireTimeCost
36878>>>>>>>                Case Break
36879>>>>>>>            Case Else
36879>>>>>>>                Error 8710 "Invalid algorithm selected."
36880>>>>>>>>
36880>>>>>>>                Function_Return 0
36881>>>>>>>        Case End
36881>>>>>>>        
36881>>>>>>>        // calculate base64 in a non-floating-manner
36881>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36882>>>>>>>        
36882>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36883>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36884>>>>>>>        If (bRequireTimeCost) Begin
36886>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36887>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36888>>>>>>>        End
36888>>>>>>>>
36888>>>>>>>        Else Begin
36889>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36890>>>>>>>        End
36890>>>>>>>>
36890>>>>>>>        
36890>>>>>>>        Function_Return ullSize
36891>>>>>>>    End_Function
36892>>>>>>>End_Class
36893>>>>>>>
36893>>>>>>>Class cPasswordHasher is a cObject
36894>>>>>>>    
36894>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36895>>>>>>>    
36895>>>>>>>    Procedure Construct_Object
36897>>>>>>>        Forward Send Construct_Object
36899>>>>>>>        
36899>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36900>>>>>>>        Property UInteger   puiSaltSize         16
36901>>>>>>>        
36901>>>>>>>        Property UInteger   puiOptTimeCost      420000
36902>>>>>>>    End_Procedure
36903>>>>>>>    
36903>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36905>>>>>>>        Boolean bOk
36905>>>>>>>        UInteger uiAlgo
36905>>>>>>>        Get peAlgorithm to uiAlgo
36906>>>>>>>        
36906>>>>>>>        Case Begin
36906>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36908>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36911>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36912>>>>>>>                Case Break
36913>>>>>>>            Case Else
36913>>>>>>>                Error 8710 "Invalid algorithm selected."
36914>>>>>>>>
36914>>>>>>>                Function_Return False
36915>>>>>>>        Case End
36915>>>>>>>        
36915>>>>>>>        Function_Return bOk
36916>>>>>>>    End_Function
36917>>>>>>>    
36917>>>>>>>    Function RequiredBufferSize Returns UBigInt
36919>>>>>>>        UBigInt ullSize
36919>>>>>>>        UInteger uiAlgo
36919>>>>>>>        Get peAlgorithm to uiAlgo
36920>>>>>>>        
36920>>>>>>>        Case Begin
36920>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36922>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36925>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36926>>>>>>>                Case Break
36927>>>>>>>            Case Else
36927>>>>>>>                Error 8710 "Invalid algorithm selected."
36928>>>>>>>>
36928>>>>>>>                Function_Return 0
36929>>>>>>>        Case End
36929>>>>>>>        
36929>>>>>>>        Function_Return ullSize
36930>>>>>>>    End_Function
36931>>>>>>>
36931>>>>>>>End_Class
36932>>>>>
36932>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36933>>>>>    
36933>>>>>    Procedure Construct_Object
36935>>>>>        Handle hoObj
36935>>>>>        
36935>>>>>        Forward Send Construct_Object
36937>>>>>        
36937>>>>>        Set pbSessionCookieHttpOnly to True
36938>>>>>        
36938>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36939>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36940>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36941>>>>>        
36941>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36942>>>>>        Set phoUserDD to hoObj
36943>>>>>        
36943>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36944>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36945>>>>>        Set phoSessionDD to hoObj
36946>>>>>        
36946>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36947>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36948>>>>>        Set phoCrypto to hoObj
36949>>>>>        
36949>>>>>        Property Boolean pbPasswordHashing True
36950>>>>>        
36950>>>>>        Property Boolean pbCreatingNewSession False
36951>>>>>        Property String psLoginName
36952>>>>>        Property String psUserName ""
36953>>>>>        Property Integer piUserRights 0
36954>>>>>    End_Procedure
36955>>>>>    
36955>>>>>    Procedure End_Construct_Object
36957>>>>>        Forward Send End_Construct_Object
36959>>>>>        
36959>>>>>        Handle hoCrypto
36959>>>>>        Integer iFieldLen
36959>>>>>        If (pbPasswordHashing(Self)) Begin
36961>>>>>            Get phoCrypto to hoCrypto
36962>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36965>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36967>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36968>>>>>>
36968>>>>>            End
36968>>>>>>
36968>>>>>        End
36968>>>>>>
36968>>>>>    End_Procedure
36969>>>>>    
36969>>>>>    Function CreateSession String sRemoteAddress Returns String
36971>>>>>        String sSessionKey
36971>>>>>        Integer iErr
36971>>>>>        Boolean bLogWebSession
36971>>>>>        Handle hoSessionDD       
36971>>>>>        Get phoSessionDD to hoSessionDD
36972>>>>>        
36972>>>>>        //  Get session key
36972>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36974>>>>>        
36974>>>>>        Get pbLogWebSession to bLogWebSession
36975>>>>>        If not bLogWebSession Begin
36977>>>>>            Function_Return sSessionKey        
36978>>>>>        End
36978>>>>>>
36978>>>>>
36978>>>>>        //  Store session
36978>>>>>        Send Clear of hoSessionDD
36979>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36980>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36981>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36982>>>>>        Get Request_Validate of hoSessionDD to iErr
36983>>>>>        If (iErr) Begin
36985>>>>>            // this should not happen. If it does its a programming error
36985>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36986>>>>>>
36986>>>>>            Function_Return ""
36987>>>>>        End
36987>>>>>>
36987>>>>>        Send Request_Save of hoSessionDD
36988>>>>>        If (Err) Begin
36990>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36990>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36991>>>>>>
36991>>>>>            Function_Return ""
36992>>>>>        End
36992>>>>>>
36992>>>>>       
36992>>>>>        Function_Return sSessionKey        
36993>>>>>    End_Function
36994>>>>>    
36994>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36996>>>>>        DateTime dtLastAccess dtCurrent
36996>>>>>        TimeSpan tsDiff
36996>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36996>>>>>        Boolean bResult bCreatingNewSession
36996>>>>>        Boolean bLogWebSession bLoadWebApp
36996>>>>>        Integer eLoginMode
36996>>>>>        String sTime
36996>>>>>        Handle hoSessionDD hoUserDD       
36996>>>>>        
36996>>>>>        Move False to bLoadWebApp
36997>>>>>        If (num_arguments >= 2) Begin
36999>>>>>            Move bOptLoadWebApp to bLoadWebApp
37000>>>>>        End
37000>>>>>>
37000>>>>>        
37000>>>>>        Get phoSessionDD to hoSessionDD
37001>>>>>        Get phoUserDD to hoUserDD
37002>>>>>        
37002>>>>>        Get pbLogWebSession to bLogWebSession
37003>>>>>        Get peLoginMode to eLoginMode
37004>>>>>        
37004>>>>>        // for this object, you can only disable logging if login completely is disabled
37004>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
37006>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
37007>>>>>>
37007>>>>>            Function_Return False
37008>>>>>        End
37008>>>>>>
37008>>>>>
37008>>>>>        //  Clear session properties
37008>>>>>        Set psSessionKey to ""
37009>>>>>        Send UpdateSessionProperties True
37010>>>>>        
37010>>>>>        If not bLogWebSession Begin
37012>>>>>            Forward Get ValidateSession sSessionKey to bResult
37014>>>>>            Function_Return bResult
37015>>>>>        End        
37015>>>>>>
37015>>>>>        
37015>>>>>        Move False to bResult
37016>>>>>        Get piSessionTimeout to iSessionTimeout 
37017>>>>>        
37017>>>>>        //  Check if session exists
37017>>>>>        Send Clear of hoSessionDD
37018>>>>>        Move sSessionKey to WebAppSession.SessionKey
37019>>>>>        Send Find of hoSessionDD EQ Index.1
37020>>>>>            
37020>>>>>        If (Found) Begin
37022>>>>>            //  Calculate timespan between now and last access time
37022>>>>>            Move (CurrentDateTime()) to dtCurrent
37023>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37024>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37025>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37026>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37027>>>>>            
37027>>>>>            //  Check if session didn't time out
37027>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37029>>>>>                Forward Get ValidateSession sSessionKey to bResult
37031>>>>>                   
37031>>>>>                If (bResult) Begin
37033>>>>>                    //  Update session record
37033>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37034>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37035>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37036>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37037>>>>>                    Get Request_Validate of hoSessionDD to iErr
37038>>>>>                    If (iErr) Begin
37040>>>>>                        // this should not happen. If it does its a programming error
37040>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37041>>>>>>
37041>>>>>                        Function_Return False
37042>>>>>                    End
37042>>>>>>
37042>>>>>                    Send Request_Save of hoSessionDD
37043>>>>>                    
37043>>>>>                    //  Update user properties
37043>>>>>                    Send UpdateSessionProperties False
37044>>>>>                End
37044>>>>>>
37044>>>>>            End
37044>>>>>>
37044>>>>>            Else Begin
37045>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37045>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37046>>>>>                
37046>>>>>                If (not(bCreatingNewSession)) Begin
37048>>>>>                    If (not(bLoadWebApp)) Begin
37050>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37051>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37052>>>>>>
37052>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37053>>>>>                    End
37053>>>>>>
37053>>>>>                    Else Begin
37054>>>>>                        Set pbCreatingNewSession to True                    
37055>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37056>>>>>                        Set pbCreatingNewSession to False                        
37057>>>>>                    End
37057>>>>>>
37057>>>>>                End
37057>>>>>>
37057>>>>>            End
37057>>>>>>
37057>>>>>        End
37057>>>>>>
37057>>>>>        Else Begin
37058>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37059>>>>>>
37059>>>>>        End
37059>>>>>>
37059>>>>>        
37059>>>>>        Function_Return bResult
37060>>>>>    End_Function
37061>>>>>    
37061>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37063>>>>>        If (not(pbPasswordHashing(Self))) Begin
37065>>>>>            Move sPassword to sHash
37066>>>>>            Function_Return True
37067>>>>>        End
37067>>>>>>
37067>>>>>        
37067>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37069>>>>>            Function_Return False
37070>>>>>        End
37070>>>>>>
37070>>>>>        Move ("V1$" + sHash) to sHash
37071>>>>>        Function_Return True
37072>>>>>    End_Function
37073>>>>>    
37073>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37075>>>>>        If (not(pbPasswordHashing(Self))) Begin
37077>>>>>            Move False to bShouldUpgrade
37078>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37079>>>>>        End
37079>>>>>>
37079>>>>>        
37079>>>>>        String sVersion
37079>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37080>>>>>        If (sVersion = "V1$") Begin
37082>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37085>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37086>>>>>        End
37086>>>>>>
37086>>>>>        Else Begin
37087>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37090>>>>>            Function_Return False
37091>>>>>        End
37091>>>>>>
37091>>>>>    End_Function
37092>>>>>    
37092>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37094>>>>>        Handle hoUserDD
37094>>>>>        Integer iErr
37094>>>>>        Get phoUserDD to hoUserDD
37095>>>>>        
37095>>>>>        //  Find the user
37095>>>>>        Send Clear of hoUserDD
37096>>>>>        Move sLoginName to WebAppUser.LoginName
37097>>>>>        Send Find of hoUserDD EQ Index.1
37098>>>>>        If (Found) Begin
37100>>>>>            Send Clear of hoUserDD
37101>>>>>            Function_Return False
37102>>>>>        End
37102>>>>>>
37102>>>>>        
37102>>>>>        Send Clear of hoUserDD
37103>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37104>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37105>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37107>>>>>            Send Clear of hoUserDD
37108>>>>>            Function_Return False
37109>>>>>        End
37109>>>>>>
37109>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37110>>>>>        Get Request_Validate of hoUserDD to iErr
37111>>>>>        If (iErr) Begin
37113>>>>>            Send Clear of hoUserDD
37114>>>>>            Function_Return False
37115>>>>>        End
37115>>>>>>
37115>>>>>        
37115>>>>>        Send Request_Save of hoUserDD
37116>>>>>        Function_Return (not(Err))
37117>>>>>    End_Function
37118>>>>>    
37118>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37120>>>>>        String sSessionKey sUserPassword
37120>>>>>        Handle hoSessionDD hoUserDD
37120>>>>>        Boolean bMatch bUpgrade
37120>>>>>        
37120>>>>>        Get phoSessionDD to hoSessionDD
37121>>>>>        Get phoUserDD to hoUserDD
37122>>>>>        Integer iErr eLoginMode
37122>>>>>        
37122>>>>>        // Refind session record
37122>>>>>        Get psSessionKey to sSessionKey
37123>>>>>        Send Clear of hoSessionDD
37124>>>>>        Move sSessionKey to WebAppSession.SessionKey
37125>>>>>        Send Find of hoSessionDD EQ Index.1
37126>>>>>        
37126>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37128>>>>>            Get peLoginMode to eLoginMode
37129>>>>>            
37129>>>>>            //  Find the user
37129>>>>>            Move sLoginName to WebAppUser.LoginName
37130>>>>>            Send Find of hoUserDD EQ Index.1
37131>>>>>            
37131>>>>>            // Check username and password
37131>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37133>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37134>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37135>>>>>                
37135>>>>>                If (bMatch) Begin
37137>>>>>                    // Store the login
37137>>>>>                    If (bUpgrade) Begin
37139>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37140>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37143>>>>>                    End
37143>>>>>>
37143>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37144>>>>>                    Get Request_Validate of hoSessionDD to iErr
37145>>>>>                    If (iErr) Begin
37147>>>>>                        // this should not happen. If it does its a programming error
37147>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37148>>>>>>
37148>>>>>                        Function_Return False
37149>>>>>                    End
37149>>>>>>
37149>>>>>                    
37149>>>>>                    Send Request_Save of hoSessionDD
37150>>>>>                    
37150>>>>>                    // Update session properties
37150>>>>>                    Send UpdateSessionProperties False
37151>>>>>                    Send NotifyChangeRights
37152>>>>>                    Function_Return True
37153>>>>>                End
37153>>>>>>
37153>>>>>                Else Begin
37154>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37154>>>>>                    Send Clear of hoUserDD
37155>>>>>                End
37155>>>>>>
37155>>>>>            End
37155>>>>>>
37155>>>>>            Else Begin
37156>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37156>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37157>>>>>            End
37157>>>>>>
37157>>>>>        End
37157>>>>>>
37157>>>>>        Else Begin
37158>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37158>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37159>>>>>        End
37159>>>>>>
37159>>>>>          
37159>>>>>        Function_Return False
37160>>>>>    End_Function
